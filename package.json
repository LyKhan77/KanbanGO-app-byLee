{
  "name": "kanbango",
  "version": "1.0.0",
  "description": "Offline-first Kanban Desktop App with Bohemian Aesthetic & Hardcore Assistant",
  "main": "./out/main/index.js",
  "author": "KanbanGO Team",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
